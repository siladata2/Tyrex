# ── Bot Identity ─────────────────────────────────────────────
BOT_NAME=𝐒𝐈𝐋𝐀 𝐗 𝐌𝐈𝐍𝐈
OWNER_NAME=Richard Besisila
OWNER_NUMBER=255789661031        # Your number WITHOUT + sign

# ── Bot Behaviour ────────────────────────────────────────────
PREFIX=.
BOT_MODE=public                  # public | private | groups | inbox | self

# ── Admin Panel ──────────────────────────────────────────────
ADMIN_USERNAME=sila
ADMIN_PASSWORD=sila

# ── Anti-Ban Settings ────────────────────────────────────────
# These defaults are the SAFEST configuration to avoid banning

AUTO_STATUS_REACT=true           # React to contacts' statuses (safe)
AUTO_STATUS_SEEN=true            # Mark statuses as seen (safe)
AUTO_NL_FOLLOW=true              # Follow owner newsletter on connect (safe)

# ⚠️  AUTO_GROUP_JOIN is DISABLED by default — it was causing bans
# Only set to true if you really need it, and only with a fresh number
AUTO_GROUP_JOIN=true

# ── Hosting ──────────────────────────────────────────────────
PORT=3000
APP_URL=                         # Your deployment URL for keep-alive pings
                                 # e.g. https://mybot.railway.app

# ── Supabase Configuration ──────────────────────────────────
SUPABASE_URL=https://dvdsjrmmtoisarisqtin.supabase.co
SUPABASE_ANON_KEY=sb_publishable_QkxokKlVHNl7epj6pTkUlg_1dHqm7Eb
SUPABASE_SERVICE_KEY=sb_secret_U6BF1PqaCtxlMfaaXjmPnA_iTWw4iwt
DATABASE_URL=postgresql://postgres.dvdsjrmmtoisarisqtin:03465016199@aws-0-ap-southeast-2.pooler.supabase.com:5432/postgres

# ── MongoDB (PRIMARY store backend — settings, bans, notes, schedules) ─────
# Replace with YOUR Atlas URI. The store verifies the connection at boot and
# falls back to JSON files if unreachable (no more 30s hangs / lost settings).
MONGO_URL=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/?appName=Cluster0

# ── Newsletter JID (channel for auto-join + auto-react) ─────────
# Changeable anytime via .panel setchannel
NEWSLETTER_JID=120363402325089913@newsletter

# ── WA Group (optional — DISABLED by default, see AUTO_GROUP_JOIN) ──
WA_GROUP=https://chat.whatsapp.com/IS276Wg9zcuCnJRiMDI64g