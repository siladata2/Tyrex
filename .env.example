# ── Bot Identity ─────────────────────────────────────────────
BOT_NAME=🔥 REDXBOT302 🔥
OWNER_NAME=Your Name
OWNER_NUMBER=923009842133        # Your number WITHOUT + sign

# ── Bot Behaviour ────────────────────────────────────────────
PREFIX=.
BOT_MODE=public                  # public | private | groups | inbox | self

# ── Admin Panel ──────────────────────────────────────────────
ADMIN_USERNAME=redx
ADMIN_PASSWORD=redx

# ── Anti-Ban Settings ────────────────────────────────────────
# These defaults are the SAFEST configuration to avoid banning

AUTO_STATUS_REACT=true           # React to contacts' statuses (safe)
AUTO_STATUS_SEEN=true            # Mark statuses as seen (safe)
AUTO_NL_FOLLOW=true              # Follow owner newsletter on connect (safe)

# ⚠️  AUTO_GROUP_JOIN is DISABLED by default — it was causing bans
# Only set to true if you really need it, and only with a fresh number
AUTO_GROUP_JOIN=false

# ── Hosting ──────────────────────────────────────────────────
