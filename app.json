{
  "name": "TYREX_KSH MD",
  "description": "TYREX_KSH MD — WhatsApp Bot (Single Session). Add your SESSION_ID and deploy. Powered By TYREX_KSH TECH",
  "logo": "https://files.catbox.moe/p8xi4o.jpeg",
  "keywords": [
    "whatsapp",
    "bot",
    "baileys",
    "silaxmini",
    "silamd",
    "session-id"
  ],
  "repository": "https://github.com/Sila-Md",
  "env": {
    "SESSION_ID": {
      "description": "Base64 session string. Format: SILA-MD~H4sIA... Generate from your creds.json (see README). REQUIRED.",
      "required": true
    },
    "BOT_NAME": {
      "description": "Bot display name",
      "value": "TYREX_KSH MD",
      "required": false
    },
    "OWNER_NUMBER": {
      "description": "Owner WhatsApp number (no + or spaces)",
      "value": "255610744352",
      "required": true
    },
    "OWNER_NAME": {
      "description": "Owner display name",
      "value": "TYREX_KSH TECH",
      "required": false
    },
    "PREFIX": {
      "description": "Command prefix",
      "value": ".",
      "required": false
    },
    "BOT_MODE": {
      "description": "public | private | groups | inbox | self",
      "value": "public",
      "required": false
    },
    "ADMIN_USERNAME": {
      "description": "Admin panel username — CHANGE THIS!",
      "value": "sila",
      "required": false
    },
    "ADMIN_PASSWORD": {
      "description": "Admin panel password — CHANGE THIS!",
      "value": "sila",
      "required": false
    },
    "APP_URL": {
      "description": "Your app URL for keep-alive ping (e.g. https://your-app.onrender.com)",
      "required": false
    },
    "MENU_IMAGE": {
      "description": "Menu thumbnail image URL",
      "value": "https://files.catbox.moe/p8xi4o.jpeg",
      "required": false
    },
    "NEWSLETTER_JID": {
      "description": "WhatsApp Channel JID to auto-follow",
      "value": "120363429539292697@newsletter",
      "required": false
    },
    "WA_GROUP": {
      "description": "WhatsApp Group invite link for auto-join",
      "value": "https://chat.whatsapp.com/IS276Wg9zcuCnJRiMDI64g",
      "required": false
    },
    "TIMEZONE": {
      "description": "Bot timezone",
      "value": "Africa/Dar_es_Salaam",
      "required": true
    },
    "AUTO_STATUS_SEEN": {
      "description": "Auto view statuses (true/false)",
      "value": "true",
      "required": true
    },
    "AUTO_STATUS_REACT": {
      "description": "Auto react to statuses (true/false)",
      "value": "true",
      "required": true
    },
    "AUTO_NL_FOLLOW": {
      "description": "Auto follow newsletter channels (true/false)",
      "value": "true",
      "required": true
    },
    "AUTO_GROUP_JOIN": {
      "description": "Auto join groups from GitHub list (true/false)",
      "value": "true",
      "required": true
    },
    "SESSION_DIR": {
      "description": "Where to store session files (default: ./sessions)",
      "value": "./sessions",
      "required": false
    },
    "MONGO_URL": {
      "description": "MongoDB connection URL (optional — for session backup)",
      "required": false
    },
    "SUPABASE_URL": {
      "description": "Supabase project URL (optional — for session backup)",
      "required": false
    },
    "SUPABASE_KEY": {
      "description": "Supabase service role key (optional — for session backup)",
      "required": false
    }
  },
  "formation": {
    "web": {
      "quantity": 1,
      "size": "basic"
    }
  },
  "buildpacks": [
    {
      "url": "https://github.com/jonathanong/heroku-buildpack-ffmpeg-latest.git"
    },
    {
      "url": "heroku/nodejs"
    }
  ],
  "stack": "heroku-26"
